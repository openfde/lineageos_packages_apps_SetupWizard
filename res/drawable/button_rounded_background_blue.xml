<!-- round_background.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 设置颜色填充 -->
    <solid android:color="#ff318BF3"/>
    <!-- 边框宽度和颜色 (可选) -->
    <stroke
        android:width="0dp"
        android:color="#000000"/>
    <!-- 圆角半径 -->
    <corners android:radius="5dp" />
</shape>