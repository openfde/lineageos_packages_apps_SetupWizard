<!-- res/drawable/custom_spinner_background.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- 背景矩形 -->
  <item>
    <shape>
      <solid android:color="#FFFFFF" />
      <corners android:radius="5dp" />
      <stroke
          android:width="0dp"
          android:color="#000000" />
    </shape>
  </item>
  <!-- 自定义箭头 -->
  <item
      android:width="16dp"
      android:height="16dp"
      android:gravity="center_vertical|end"
      android:drawable="@drawable/icon_list_retract"
      android:end="12dp" />
</layer-list>